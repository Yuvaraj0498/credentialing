# Per-site deploy settings. Copy to deploy/site.env on each site (deploy/site.env is NOT in git).
#
#                   desssnext (testing)     credentiallingjs (live)
#   BRANCH          main                    production
#   BACKEND_PM2     credential-backend      zmart-backend
#   ADMIN_PM2       credential-admin        zmart-admin
#   ADMIN_PORT      3008                    3009
#   (the API port is server.port in backend/config/application.properties: 8085 / 8086)

# git branch this site runs
BRANCH=main
# pm2 process names of this site
BACKEND_PM2=credential-backend
ADMIN_PM2=credential-admin
# port of this site's admin app (Apache proxies /admin to it)
ADMIN_PORT=3008
