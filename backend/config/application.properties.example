# ============================================================
# SERVER settings — copy this file to  backend/config/application.properties  and fill in the values.
# Spring Boot reads ./config/application.properties automatically when the API is started from the backend folder.
# The real file holds secrets: it is git-ignored and must never be committed.
# ============================================================

# API port — different for every site on the server (Apache proxies /api -> 127.0.0.1:<port>)
#   desssnext (testing) = 8085   credentialingsjs (live) = 9090
server.port=8085

# Database — one per site: desssnext = credentialing, credentialingsjs = zmartcredential.
# createDatabaseIfNotExist creates it on the first start; Flyway then creates all tables.
spring.datasource.url=jdbc:mysql://localhost:3306/credentialing?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
spring.datasource.username=CHANGE_ME
spring.datasource.password=CHANGE_ME

# Schema + reference data + demo data. To start WITHOUT demo data on a new database use: classpath:db/migration
spring.flyway.locations=classpath:db/migration,classpath:db/demo

# Security keys — generate long random values once (e.g.  openssl rand -base64 48).
# NEVER change app.encryption-key after the first start: stored payer / CAQH passwords would become unreadable.
app.jwt.secret=CHANGE_ME_LONG_RANDOM_VALUE
app.encryption-key=CHANGE_ME_LONG_RANDOM_VALUE

# The admin app's public origin (browser address) and HTTPS-only refresh cookie
app.cors.allowed-origins=https://your-site.desss-portfolio.com
app.cookie-secure=true

# Uploaded documents (relative to the backend folder)
app.storage.path=./uploads

# Super admin sign-in of THIS site (optional). Set = the super admin signs in with these (applied on every start).
# Left out = the default super admin dev@desss.com / Admin@123.
#app.super-admin.email=info@patriotmedbill.com
#app.super-admin.password=CHANGE_ME

# ---------- Email (SMTP) ----------
app.public-url=https://your-site.desss-portfolio.com
app.mail.enabled=true
app.mail.from=CHANGE_ME@your-domain.com
app.mail.from-name=ZmartCredential
spring.mail.host=smtp.ionos.com
spring.mail.port=587
spring.mail.username=CHANGE_ME
spring.mail.password=CHANGE_ME
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
spring.mail.properties.mail.smtp.ssl.enable=false
