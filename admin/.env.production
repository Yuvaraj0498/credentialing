# SERVER settings for the admin app (read by "npm run build" — rebuild after changing).
# Public API address: Apache proxies /api -> Spring Boot on 127.0.0.1:8085
NEXT_PUBLIC_API_URL=https://desssnext.desss-portfolio.com/api
# Show the demo-account list (usernames + passwords) on the sign-in page; set false to hide it
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
