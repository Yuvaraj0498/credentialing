# SERVER settings for the admin app (read by "npm run build").
# "/api" = the API of the site the page is opened from (Apache proxies /api to that site's backend), so the
# same build works on every site (desssnext = testing, credentiallingjs = live). A site can override this in
# admin/.env.production.local (not in git).
NEXT_PUBLIC_API_URL=/api
# Show the demo-account list (usernames + passwords) on the sign-in page; set false to hide it
NEXT_PUBLIC_SHOW_DEMO_ACCOUNTS=false
