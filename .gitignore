# Root ignores (each app also has its own .gitignore)

# Local-only folders and packages (not part of the app)
_unused/
*.zip

# Dependencies and build output
node_modules/
.next/
target/
*.tsbuildinfo

# Editors / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Local env files and logs
.env
.env.local
.env*.local
*.log

# Uploaded documents (server data)
backend/uploads/


# Server-only settings (contain secrets). Copy the example to application.properties on the server.
backend/config/*
!backend/config/application.properties.example

# Generated by "next dev"
admin/AGENTS.md
admin/CLAUDE.md
